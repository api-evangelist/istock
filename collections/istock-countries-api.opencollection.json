{
  "opencollection": "1.0.0",
  "info": {
    "name": "iStock API (Getty Images Platform) Countries API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Countries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List countries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.gettyimages.com/v3/countries"
          },
          "docs": "List countries"
        }
      ]
    }
  ],
  "bundled": true
}